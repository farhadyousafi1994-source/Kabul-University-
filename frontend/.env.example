# API base path (the Vite dev server proxies /api to the Laravel backend,
# or serves the development mock API — see vite.config.js).
VITE_API_BASE=/api

# Dev-only: serve the built-in mock REST API instead of proxying to Laravel.
# Set to false and run `php artisan serve` in ../backend for the real API.
VITE_USE_MOCK_API=true
